---
interface Props {
  postSlug: string;
}
const { postSlug } = Astro.props;
---

<section class="comments-section" data-slug={postSlug}>
  <h3>Comments</h3>
  <div class="comments-list">
    <p class="loading-msg">Loading...</p>
  </div>
  <form class="comment-form">
    <input type="text" name="author" placeholder="Name (optional)" autocomplete="off" />
    <textarea name="content" placeholder="Leave a comment..." rows="3" required></textarea>
    <button type="submit">Post Comment</button>
  </form>
</section>

<style>
  .comments-section {
    padding-top: 1rem;
  }
  .comments-section h3 {
    font-size: 1rem;
    margin: 0 0 1rem 0;
    color: rgb(var(--gray-dark));
  }
  .comment-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgb(var(--gray-light));
  }
  .comment-item:last-child {
    border-bottom: none;
  }
  .comment-meta {
    font-size: 0.78rem;
    color: rgb(var(--gray));
    margin-bottom: 0.25rem;
  }
  .comment-body {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .comment-form input,
  .comment-form textarea {
    padding: 0.5rem 0.7rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 6px;
    font-size: 0.9rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }
  .comment-form input:focus,
  .comment-form textarea:focus {
    outline: none;
    border-color: #2337ff;
  }
  .comment-form textarea {
    resize: vertical;
  }
  .comment-form button {
    align-self: flex-start;
    padding: 0.4rem 1rem;
    background: #2337ff;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.88rem;
    font-family: inherit;
    transition: opacity 0.15s;
  }
  .comment-form button:hover {
    opacity: 0.85;
  }
  .loading-msg {
    font-size: 0.85rem;
    color: rgb(var(--gray));
    margin: 0;
  }
  .empty-msg {
    font-size: 0.85rem;
    color: rgb(var(--gray));
    margin: 0 0 1rem 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const section = document.querySelector('.comments-section') as HTMLElement | null;
  if (section) {
    const slug = section.dataset.slug!;
    const list = section.querySelector('.comments-list')!;
    const form = section.querySelector('.comment-form') as HTMLFormElement;

    function formatDate(iso: string) {
      return new Date(iso).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function renderComment(c: { author_name?: string; content: string; created_at: string }) {
      const item = document.createElement('div');
      item.className = 'comment-item';
      item.innerHTML = `
        <div class="comment-meta">${c.author_name ?? 'Anonymous'} · ${formatDate(c.created_at)}</div>
        <p class="comment-body">${c.content.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
      `;
      return item;
    }

    const { data: comments } = await supabase
      .from('comments')
      .select('*')
      .eq('post_slug', slug)
      .order('created_at', { ascending: false });

    list.innerHTML = '';
    if (!comments || comments.length === 0) {
      const msg = document.createElement('p');
      msg.className = 'empty-msg';
      msg.textContent = 'No comments yet. Be the first!';
      list.appendChild(msg);
    } else {
      comments.forEach((c: { author_name?: string; content: string; created_at: string }) => {
        list.appendChild(renderComment(c));
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const author = (form.elements.namedItem('author') as HTMLInputElement).value.trim();
      const content = (form.elements.namedItem('content') as HTMLTextAreaElement).value.trim();
      if (!content) return;

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting...';

      const { data: inserted } = await supabase
        .from('comments')
        .insert({ post_slug: slug, author_name: author || null, content })
        .select()
        .single();

      submitBtn.disabled = false;
      submitBtn.textContent = 'Post Comment';

      if (inserted) {
        list.querySelector('.empty-msg')?.remove();
        list.insertBefore(renderComment(inserted), list.firstChild);
        form.reset();
      }
    });
  }
</script>
