---
interface Props {
  postSlug: string;
}
const { postSlug } = Astro.props;
---

<div id="ih-root" data-slug={postSlug}></div>

<style is:global>
  mark.ih-highlight {
    background: rgba(35, 55, 255, 0.1);
    border-bottom: 2px solid #2337ff;
    padding: 0 1px;
    border-radius: 2px;
    cursor: pointer;
    position: relative;
  }
  mark.ih-highlight:hover {
    background: rgba(35, 55, 255, 0.18);
  }
  .ih-badge {
    display: inline-block;
    background: #2337ff;
    color: white;
    font-size: 0.62rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0 4px;
    margin-left: 2px;
    vertical-align: super;
    line-height: 1.6;
    pointer-events: none;
  }
  #ih-toolbar {
    position: fixed;
    background: white;
    border: 1px solid rgb(60, 80, 180, 0.2);
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 0;
    z-index: 9999;
  }
  #ih-emoji-row {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  #ih-toolbar button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.15rem;
    padding: 4px 6px;
    border-radius: 6px;
    transition: background 0.1s;
    font-family: inherit;
  }
  #ih-toolbar button:hover {
    background: rgba(35, 55, 255, 0.08);
  }
  #ih-comment-form {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 8px;
    border-top: 1px solid rgba(35, 55, 255, 0.1);
    margin-top: 6px;
    width: 220px;
  }
  #ih-comment-form input,
  #ih-comment-form textarea {
    padding: 5px 8px;
    border: 1px solid rgb(229, 233, 240);
    border-radius: 6px;
    font-size: 0.85rem;
    font-family: inherit;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }
  #ih-comment-form input:focus,
  #ih-comment-form textarea:focus {
    outline: none;
    border-color: #2337ff;
  }
  #ih-comment-form textarea {
    resize: none;
  }
  #ih-comment-form .ih-form-btns {
    display: flex;
    gap: 6px;
    justify-content: flex-end;
  }
  #ih-comment-form .ih-form-btns button {
    font-size: 0.8rem;
    padding: 3px 10px;
    border-radius: 5px;
    border: 1px solid rgb(229, 233, 240);
    cursor: pointer;
    font-family: inherit;
  }
  #ih-comment-form .ih-form-btns .ih-submit-btn {
    background: #2337ff;
    color: white;
    border-color: #2337ff;
  }
  #ih-panel {
    position: fixed;
    background: white;
    border: 1px solid rgb(229, 233, 240);
    border-radius: 10px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    padding: 12px 14px;
    width: 260px;
    max-height: 280px;
    overflow-y: auto;
    z-index: 9999;
  }
  .ih-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgb(229, 233, 240);
  }
  .ih-panel-header span {
    font-size: 0.82rem;
    font-weight: 600;
    color: rgb(34, 41, 57);
  }
  .ih-panel-header button {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: rgb(96, 115, 159);
    padding: 0;
    line-height: 1;
    font-family: inherit;
  }
  .ih-reaction-row {
    font-size: 0.9rem;
    margin-bottom: 8px;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .ih-ann-item {
    padding: 6px 0;
    border-bottom: 1px solid rgb(229, 233, 240);
    font-size: 0.85rem;
  }
  .ih-ann-item:last-child { border-bottom: none; }
  .ih-ann-meta {
    font-size: 0.75rem;
    color: rgb(96, 115, 159);
    margin-bottom: 2px;
  }
  .ih-empty {
    font-size: 0.85rem;
    color: rgb(96, 115, 159);
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const root = document.getElementById('ih-root') as HTMLElement | null;
  if (!root) throw new Error('ih-root missing');
  const slug = root.dataset.slug!;
  const prose = document.querySelector('.prose') as HTMLElement | null;
  if (!prose) throw new Error('.prose missing');

  // ── Build UI elements ──────────────────────────────────────────────────────

  const toolbar = document.createElement('div');
  toolbar.id = 'ih-toolbar';
  toolbar.style.display = 'none';
  toolbar.innerHTML = `
    <div id="ih-emoji-row">
      <button data-rtype="heart" title="Heart">❤️</button>
      <button data-rtype="laugh" title="Laugh">😂</button>
      <button data-rtype="wow"   title="Wow">😮</button>
      <button data-rtype="cry"   title="Sad">😢</button>
      <button data-show-comment  title="Comment">💬</button>
    </div>
    <div id="ih-comment-form" style="display:none">
      <input id="ih-author" type="text" placeholder="Name (optional)" />
      <textarea id="ih-content" rows="2" placeholder="Your comment..."></textarea>
      <div class="ih-form-btns">
        <button class="ih-cancel-btn">Cancel</button>
        <button class="ih-submit-btn">Post</button>
      </div>
    </div>
  `;
  document.body.appendChild(toolbar);

  const panel = document.createElement('div');
  panel.id = 'ih-panel';
  panel.style.display = 'none';
  panel.innerHTML = `
    <div class="ih-panel-header">
      <span>Highlights</span>
      <button id="ih-panel-close">×</button>
    </div>
    <div id="ih-panel-body"></div>
  `;
  document.body.appendChild(panel);

  // ── State ──────────────────────────────────────────────────────────────────

  let pending: { text: string; occurrenceIndex: number } | null = null;

  function hideToolbar() {
    toolbar.style.display = 'none';
    (document.getElementById('ih-comment-form') as HTMLElement).style.display = 'none';
    (document.getElementById('ih-content') as HTMLTextAreaElement).value = '';
    (document.getElementById('ih-author') as HTMLInputElement).value = '';
    pending = null;
  }

  const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;

  function positionEl(el: HTMLElement, refRect: DOMRect) {
    const margin = 8;
    // On touch devices, always place below so the native copy/paste popup (above) has clear space
    let top = isTouchDevice
      ? refRect.bottom + margin
      : refRect.top - el.offsetHeight - margin;
    if (!isTouchDevice && top < margin) top = refRect.bottom + margin;
    let left = refRect.left + refRect.width / 2 - el.offsetWidth / 2;
    left = Math.max(margin, Math.min(left, window.innerWidth - el.offsetWidth - margin));
    el.style.top = `${top}px`;
    el.style.left = `${left}px`;
  }

  // ── Click outside to dismiss ───────────────────────────────────────────────

  function handleDismiss(e: Event) {
    const target = e.target as Node;
    if (!toolbar.contains(target)) hideToolbar();
    if (!panel.contains(target) && !(target as HTMLElement).closest?.('mark.ih-highlight')) {
      panel.style.display = 'none';
    }
  }
  document.addEventListener('mousedown', handleDismiss);
  document.addEventListener('touchstart', handleDismiss, { passive: true });

  document.getElementById('ih-panel-close')!.addEventListener('click', () => {
    panel.style.display = 'none';
  });

  // ── Selection listener ─────────────────────────────────────────────────────

  function getOccurrenceIndex(searchText: string, range: Range): number {
    const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
    let count = 0;
    let node: Text | null;
    while ((node = walker.nextNode() as Text | null)) {
      if ((node.parentElement as HTMLElement | null)?.closest('mark')) continue;
      const content = node.textContent!;
      let pos = 0;
      while (true) {
        const idx = content.indexOf(searchText, pos);
        if (idx === -1) break;
        if (node === range.startContainer && idx === range.startOffset) return count;
        count++;
        pos = idx + 1;
      }
    }
    return 0;
  }

  function handleSelectionEnd() {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed) return;
    const text = sel.toString().trim();
    if (!text || text.length > 300) return;

    const range = sel.getRangeAt(0);
    if (!prose.contains(range.commonAncestorContainer)) return;

    const occurrenceIndex = getOccurrenceIndex(text, range);
    pending = { text, occurrenceIndex };
    const rect = range.getBoundingClientRect();

    toolbar.style.display = 'flex';
    (document.getElementById('ih-comment-form') as HTMLElement).style.display = 'none';

    // Position after the browser lays out the toolbar
    requestAnimationFrame(() => positionEl(toolbar, rect));
  }

  prose.addEventListener('mouseup', handleSelectionEnd);
  // On mobile, getSelection() may not update until after touchend resolves
  prose.addEventListener('touchend', () => setTimeout(handleSelectionEnd, 0));

  // ── Toolbar buttons ────────────────────────────────────────────────────────

  toolbar.querySelectorAll('[data-rtype]').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (!pending) return;
      const type = (btn as HTMLElement).dataset.rtype!;
      const lsKey = `ih:${slug}:${pending.text}:${type}`;
      if (localStorage.getItem(lsKey)) return;
      await supabase.from('inline_annotations').insert({
        post_slug: slug,
        selected_text: pending.text,
        occurrence_index: pending.occurrenceIndex,
        annotation_type: 'reaction',
        reaction_type: type,
      });
      localStorage.setItem(lsKey, '1');
      window.getSelection()?.removeAllRanges();
      hideToolbar();
      await loadAndApply();
    });
  });

  toolbar.querySelector('[data-show-comment]')?.addEventListener('click', (e) => {
    e.stopPropagation();
    (document.getElementById('ih-comment-form') as HTMLElement).style.display = 'flex';
    (document.getElementById('ih-content') as HTMLTextAreaElement).focus();
    requestAnimationFrame(() => positionEl(toolbar, toolbar.getBoundingClientRect()));
  });

  toolbar.querySelector('.ih-cancel-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    (document.getElementById('ih-comment-form') as HTMLElement).style.display = 'none';
  });

  toolbar.querySelector('.ih-submit-btn')?.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (!pending) return;
    const content = (document.getElementById('ih-content') as HTMLTextAreaElement).value.trim();
    if (!content) return;
    const author = (document.getElementById('ih-author') as HTMLInputElement).value.trim();
    await supabase.from('inline_annotations').insert({
      post_slug: slug,
      selected_text: pending.text,
      occurrence_index: pending.occurrenceIndex,
      annotation_type: 'comment',
      content,
      author_name: author || null,
    });
    window.getSelection()?.removeAllRanges();
    hideToolbar();
    await loadAndApply();
  });

  // ── Annotation panel ───────────────────────────────────────────────────────

  function showPanel(e: MouseEvent, text: string, annotations: Array<{
    annotation_type: string;
    reaction_type?: string;
    content?: string;
    author_name?: string;
    created_at: string;
  }>) {
    const body = document.getElementById('ih-panel-body')!;
    const emojiMap: Record<string, string> = { heart: '❤️', laugh: '😂', wow: '😮', cry: '😢' };

    const reactions = annotations.filter(a => a.annotation_type === 'reaction');
    const comments = annotations.filter(a => a.annotation_type === 'comment');

    const rCounts: Record<string, number> = {};
    reactions.forEach(r => { if (r.reaction_type) rCounts[r.reaction_type] = (rCounts[r.reaction_type] ?? 0) + 1; });

    let html = '';
    const rEntries = Object.entries(rCounts);
    if (rEntries.length) {
      html += `<div class="ih-reaction-row">${rEntries.map(([t, c]) => `${emojiMap[t] ?? '?'} ${c}`).join('  ')}</div>`;
    }
    comments.forEach(c => {
      const date = new Date(c.created_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
      html += `<div class="ih-ann-item"><div class="ih-ann-meta">${c.author_name ?? 'Anonymous'} · ${date}</div>${(c.content ?? '').replace(/</g, '&lt;')}</div>`;
    });
    if (!html) html = '<p class="ih-empty">No annotations yet</p>';

    body.innerHTML = html;
    panel.style.display = 'block';

    const refRect = { top: e.clientY, left: e.clientX, bottom: e.clientY, right: e.clientX, width: 0, height: 0 } as DOMRect;
    requestAnimationFrame(() => positionEl(panel, refRect));
  }

  // ── Highlight rendering ────────────────────────────────────────────────────

  function removeExistingHighlights() {
    prose.querySelectorAll('mark.ih-highlight').forEach(mark => {
      const parent = mark.parentNode!;
      const original = (mark as HTMLElement).dataset.text ?? mark.textContent ?? '';
      parent.replaceChild(document.createTextNode(original), mark);
      parent.normalize();
    });
  }

  function wrapFirstOccurrence(searchText: string, occurrenceIndex: number, count: number, annotations: object[]) {
    const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
    let seen = 0;
    let node: Text | null;

    while ((node = walker.nextNode() as Text | null)) {
      if ((node.parentElement as HTMLElement | null)?.closest('mark')) continue;
      const content = node.textContent!;
      let pos = 0;
      while (true) {
        const idx = content.indexOf(searchText, pos);
        if (idx === -1) break;
        if (seen === occurrenceIndex) {
          const before = content.slice(0, idx);
          const after = content.slice(idx + searchText.length);
          const parent = node.parentNode!;

          const mark = document.createElement('mark');
          mark.className = 'ih-highlight';
          mark.dataset.text = searchText;
          mark.appendChild(document.createTextNode(searchText));

          const badge = document.createElement('span');
          badge.className = 'ih-badge';
          badge.textContent = String(count);
          mark.appendChild(badge);

          if (before) parent.insertBefore(document.createTextNode(before), node);
          parent.insertBefore(mark, node);
          if (after) parent.insertBefore(document.createTextNode(after), node);
          parent.removeChild(node);

          mark.addEventListener('click', (e) => {
            e.stopPropagation();
            showPanel(e as MouseEvent, searchText, annotations as Parameters<typeof showPanel>[2]);
          });

          return;
        }
        seen++;
        pos = idx + 1;
      }
    }
  }

  async function loadAndApply() {
    const { data: annotations } = await supabase
      .from('inline_annotations')
      .select('*')
      .eq('post_slug', slug);

    removeExistingHighlights();
    if (!annotations || annotations.length === 0) return;

    const groups: Record<string, typeof annotations> = {};
    annotations.forEach((a: { selected_text: string; occurrence_index?: number }) => {
      const key = `${a.selected_text}\0${a.occurrence_index ?? 0}`;
      if (!groups[key]) groups[key] = [];
      groups[key].push(a);
    });

    for (const [key, anns] of Object.entries(groups)) {
      const [text, idxStr] = key.split('\0');
      wrapFirstOccurrence(text, Number(idxStr), anns.length, anns);
    }
  }

  await loadAndApply();
</script>
